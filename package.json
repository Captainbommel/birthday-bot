{
  "name": "birthday-bot",
  "version": "1.0.0",
  "description": "A WhatsApp bot that tracks birthdays and sends automatic birthday messages",
  "main": "index.js",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "start": "bun index.js",
    "dev": "bun index.js",
    "clean": "rm -rf .wwebjs_auth .wwebjs_cache bot.log",
    "clean-start": "bun run clean && bun run start",
    "logs": "type bot.log",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "birthday",
    "automation"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cron-parser": "^5.5.0",
    "moment-timezone": "^0.6.1",
    "node-cron": "^4.2.1",
    "openai": "^5.23.2",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.6"
  },
  "devDependencies": {}
}
